# ==========================================
# ZAPEA - GITIGNORE PRINCIPAL
# ==========================================

# Dependencias
node_modules/
**/node_modules/

# Variables de entorno
.env
**/.env
.env.*
**/.env.*

# Permitir archivos de ejemplo
!.env.example
!**/.env.example

# Builds y archivos generados
dist/
**/dist/
build/
**/build/

# Prisma generado
/generated/prisma/
**/generated/prisma/

# Archivos subidos por usuarios
uploads/
**/uploads/

# Claves y certificados privados
*.pem
*.key
*.p12
*.pfx
*.crt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cobertura de pruebas
coverage/
.nyc_output/

# Sistema operativo
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/

# Archivos temporales
*.tmp
*.temp